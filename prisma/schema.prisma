// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

enum genderStatus {
  MALE
  FEMALE
  OTHER
}

enum ActivityCategory {
  HEALTH
  ENTERTAINMENT
  ART
  FOOD
  TRAVEL
}

enum ActivityStatus {
  OPEN
  FULL
  FINISHED
  CANCELLED
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ActivityInterest {
  foodie
  camping
  slowlife
  health
  art
  travel
  entertainment
  sport
  volunteer
  workstation
}

model User {
  id           Int          @id @default(autoincrement())
  username     String?      @unique
  firebase_uid String?      @unique
  firstName    String?
  lastName     String?
  email        String       @unique
  password     String
  gender       genderStatus @default(OTHER)
  role         Role         @default(USER)
  profileImg   String?
  bio          String?

  isVerified     Boolean @default(false)
  faceDescriptor String? @db.LongText

  trustScore Int      @default(100)
  createdAt  DateTime @default(now())

  createdActivities Activity[]     @relation("UserCreatedActivities")
  joinRequests      JoinRequest[]
  reviewsGiven      Review[]       @relation("Reviewer")
  reviewsReceived   Review[]       @relation("Receiver")
  visitedPlaces     VisitedPlace[]
  messages          Message[]
  createdRoutes     Route[]

  sentFriendRequests     FriendShip[] @relation("SentFriendRequests")
  receivedFriendRequests FriendShip[] @relation("ReceivedFriendRequests")
}

model Activity {
  id              Int              @id @default(autoincrement())
  category        ActivityCategory
  title           String
  description     String           @db.Text
  coverPhoto      String?
  maxParticipants Int?
  status          ActivityStatus   @default(OPEN)
  eventStartTime  DateTime
  eventEndTime    DateTime?
  isPublic        Boolean          @default(true)
  createdAt       DateTime         @default(now())

  hostId Int
  host   User @relation("UserCreatedActivities", fields: [hostId], references: [id])

  placeId Int?
  place   Place? @relation(fields: [placeId], references: [id])

  joinRequests JoinRequest[]
  reviews      Review[]
  chatGroup    ChatGroup?
}

model JoinRequest {
  id        Int           @id @default(autoincrement())
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now())

  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([userId, activityId])
}

model Place {
  id        Int     @id @default(autoincrement())
  placeName String
  latitude  Float
  longitude Float
  address   String?

  visitedBy  VisitedPlace[]
  activities Activity[]
  routeItems RouteItem[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int
  comment   String?  @db.Text
  imageUrl  String?
  createdAt DateTime @default(now())

  reviewerId Int
  reviewer   User @relation("Reviewer", fields: [reviewerId], references: id, onDelete: Cascade)

  receiverId Int?
  receiver   User? @relation("Receiver", fields: [receiverId], references: id, onDelete: Cascade)

  activityId Int
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

model Route {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  creatorId   Int
  creator     User        @relation(fields: [creatorId], references: id, onDelete: Cascade)
  items       RouteItem[]
  createdAt   DateTime    @default(now())
}

model RouteItem {
  id      Int   @id @default(autoincrement())
  order   Int
  routeId Int
  route   Route @relation(fields: [routeId], references: id)
  placeId Int
  place   Place @relation(fields: [placeId], references: id)
}

model FriendShip {
  id        Int              @id @default(autoincrement())
  status    FriendshipStatus @default(PENDING)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @default(now()) @updatedAt

  senderId   Int
  sender     User @relation("SentFriendRequests", fields: [senderId], references: id, onDelete: Cascade)
  receiverId Int
  receiver   User @relation("ReceivedFriendRequests", fields: [receiverId], references: id, onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model VisitedPlace {
  id      Int      @id @default(autoincrement())
  at      DateTime @default(now())
  userId  Int
  user    User     @relation(fields: [userId], references: id, onDelete: Cascade)
  placeId Int
  place   Place    @relation(fields: [placeId], references: id)
}

model ChatGroup {
  id         Int       @id @default(autoincrement())
  activityId Int       @unique
  activity   Activity  @relation(fields: [activityId], references: id, onDelete: Cascade)
  messages   Message[]
}

model Message {
  id          Int       @id @default(autoincrement())
  content     String    @db.Text
  createdAt   DateTime  @default(now())
  senderId    Int
  sender      User      @relation(fields: [senderId], references: id, onDelete: Cascade)
  chatGroupId Int
  chatGroup   ChatGroup @relation(fields: [chatGroupId], references: id, onDelete: Cascade)
}

model Interest {
  id        Int               @id @default(autoincrement())
  userId    Int
  category  ActivityInterest?
  createdAt DateTime          @default(now())
}
